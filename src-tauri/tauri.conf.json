{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "ClutchBoard",
    "version": "../package.json",
    "identifier": "me.gurkankaradag.clutchboard",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "ClutchBoard",
                "width": 1280,
                "height": 820,
                "minWidth": 960,
                "minHeight": 640,
                "center": true,
                "label": "main",
                "visible": false,
                "backgroundColor": "#0F1218"
            },
            {
                "label": "splash",
                "title": "ClutchBoard",
                "url": "splash.html",
                "width": 300,
                "height": 300,
                "resizable": false,
                "maximizable": false,
                "minimizable": false,
                "decorations": false,
                "center": true,
                "closable": false,
                "backgroundColor": "#0F1218"
            }
        ],
        "security": {
            "csp": null
        },
        "appDirectoriesOverride": {
            "config": "$DATA/ClutchBoard",
            "data": "$DATA/ClutchBoard",
            "localData": "$LOCALDATA/ClutchBoard/WebView",
            "cache": "$LOCALDATA/ClutchBoard/Cache",
            "log": "$LOCALDATA/ClutchBoard/Logs"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
        "createUpdaterArtifacts": true,
        "publisher": "Gürkan Karadağ",
        "shortDescription": "Valorant stats tracker",
        "windows": {
            "nsis": {
                "installerHooks": "./windows/hooks.nsh"
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1OUFFMkUxNDdDQ0Q1MDUKUldRRjFjeEg0ZUtheGMvSk5KL3d4MW4xZ3I0ZGtnWDBtdUhmR3NzUis5NkpuOWE5SWNqa2RxcGQK",
            "endpoints": ["https://github.com/Gurkankaradag0/ClutchBoard/releases/latest/download/latest.json"],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
