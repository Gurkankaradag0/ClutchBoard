{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "ClutchBoard Setup",
    "version": "../package.json",
    "identifier": "me.gurkankaradag.clutchboard.setup",
    "build": {
        "frontendDist": "./ui"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "ClutchBoard Setup",
                "width": 440,
                "height": 300,
                "resizable": false,
                "maximizable": false,
                "decorations": false,
                "center": true,
                "backgroundColor": "#0F1218"
            }
        ],
        "security": {
            "csp": null
        },
        "appDirectoriesOverride": "$TEMP/ClutchBoardSetup"
    },
    "bundle": {
        "active": false,
        "icon": ["../src-tauri/icons/icon.ico"]
    }
}
